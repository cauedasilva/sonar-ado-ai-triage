# Copie para .env e preencha. O .env nunca deve ser versionado.

# SonarQube
SONAR_URL=https://sonar.sua-empresa.com
SONAR_TOKEN=
SONAR_SEVERITIES=BLOCKER,HIGH
SONAR_STATUSES=OPEN
# Opcional: lista separada por vírgula
SONAR_PROJECTS=

# Azure DevOps (necessário para --apply)
ADO_ORG_URL=https://dev.azure.com/sua-org
ADO_PROJECT=
# PAT com escopo "Work Items (Read & write)"
ADO_TOKEN=
ADO_WORK_ITEM_TYPE=Task
ADO_AREA_PATH=
ADO_EXTRA_TAGS=appsec;sonar

# LLM: anthropic | offline
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_MAX_OUTPUT_TOKENS=1200
ANTHROPIC_API_KEY=

CONTEXT_LINES=8
